# ===== 前端环境变量样例（构建时注入）=====
# 复制为 .env.local（本地）或在部署平台后台配置同名变量

# 后端接口地址（构建时写入产物，运行时不可改）
# 前后端同源部署（一体化 Docker / 一体化服务）：保持 /api
# 前后端分离部署（前端 Vercel + 后端 Render/Railway）：填后端的 /api 地址
VITE_API_BASE=/api

# 站点基路径：
#   根域名部署（如 https://xxx.vercel.app）→ /
#   GitHub Pages 子目录部署（如 https://user.github.io/repo/）→ /repo/
VITE_BASE=/

# 本地开发时前端代理到的后端地址
VITE_PROXY_TARGET=http://localhost:3001

# 请求超时（毫秒）
VITE_API_TIMEOUT=30000
