# ===== 后端环境变量样例（部署时在平台后台填写同名变量）=====
# 复制为 .env 后按需修改（.env 不要提交到代码仓库）

# 运行端口（Render / Railway 会自动注入 PORT，一般无需手填）
PORT=3001

# ===== 数据库 =====
# 方式 A：Postgres（推荐，生产用）—— Supabase → Project Settings → Database → Connection string
#        选「URI」格式，把 [YOUR-PASSWORD] 换成数据库密码
# DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xxx.region.pool.supabase.com:5432/postgres
#        填了 DATABASE_URL 即自动切换到 postgres 驱动
#
# 方式 B：SQLite（本地/单机）—— 不设 DATABASE_URL 即用 SQLite
# DB_FILE=/app/data/wms.db

# 显式指定驱动（可选：sqlite | postgres，留空则按 DATABASE_URL 自动判定）
# DB_DRIVER=postgres

# Postgres SSL（Supabase 远程连接需开启；自建内网库可设为 false）
# PGSSL=true
# PG_POOL_MAX=10

# ===== 安全 =====
# JWT 登录令牌密钥：生产环境必须设置为随机长字符串
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为随机长字符串

# 允许跨域的前端来源，逗号分隔；前后端同源部署时留空即可
# CORS_ORIGIN=https://your-wms.vercel.app,https://your-wms.netlify.app

# 是否由本服务托管前端静态文件（一体化部署为 true，前后端分离为 false）
# SERVE_WEB=true
